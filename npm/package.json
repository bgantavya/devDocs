    "gemini",
    "claude",
    "markdown",
    "static-analysis",
    "code-documentation",
    "zero-dependency"
  ],
  "homepage": "https://github.com/bgantavya/devDocs/tree/v4/npm#readme",
  "bugs": {
    "url": "https://github.com/bgantavya/devDocs/issues"
  },
  "repository": {

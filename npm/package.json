    "url": "git+https://github.com/bgantavya/devDocs.git",
    "directory": "npm"
  },
  "license": "MIT",
  "author": "Gantavya Bansal",
  "type": "commonjs",
  "bin": {
    "devdocs": "bin/devdocs.js"
  },
